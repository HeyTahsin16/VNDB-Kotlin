<?xml version="1.0" encoding="utf-8"?>
<!--
    Data extraction rules for Android 12 (API 31) and higher (B6, S5).
    Includes Room database and non-sensitive DataStore settings while
    excluding encrypted API token storage and legacy preferences from cloud backup
    and device-to-device transfer.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />

        <exclude domain="file" path="datastore/vndb_secure_token.preferences_pb" />
        <exclude domain="sharedpref" path="vndb_secure_token_prefs.xml" />
        <exclude domain="sharedpref" path="VndbKotlinPreferences.xml" />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />

        <exclude domain="file" path="datastore/vndb_secure_token.preferences_pb" />
        <exclude domain="sharedpref" path="vndb_secure_token_prefs.xml" />
        <exclude domain="sharedpref" path="VndbKotlinPreferences.xml" />
    </device-transfer>
</data-extraction-rules>
