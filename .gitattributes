# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Shell and Gradle wrapper scripts must use LF
*.sh text eol=lf
gradlew text eol=lf

# Windows batch scripts must use CRLF
*.bat text eol=crlf
gradlew.bat text eol=crlf

# Source & configuration files
*.kt text eol=lf
*.kts text eol=lf
*.xml text eol=lf
*.json text eol=lf
*.toml text eol=lf
*.properties text eol=lf
*.pro text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# Binary assets
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.gif binary
*.ico binary
*.jar binary
*.keystore binary
*.jks binary
