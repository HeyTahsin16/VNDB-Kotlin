# Copy this file to `keystore.properties` (which is git-ignored) at the repository root
# to sign local release builds (`./gradlew assembleRelease`).
#
# Alternatively, set the following environment variables in CI:
#   KEYSTORE_FILE=/path/to/release-keystore.jks
#   KEYSTORE_PASSWORD=your_keystore_password
#   KEY_ALIAS=your_key_alias
#   KEY_PASSWORD=your_key_password
#
# If neither `keystore.properties` nor `KEYSTORE_*` environment variables are provided,
# the release build remains unsigned and Gradle logs a warning.

storeFile=release-keystore.jks
storePassword=changeit
keyAlias=vndb-kotlin
keyPassword=changeit
